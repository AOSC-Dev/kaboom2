#!/bin/bash
set_trap

pushd Python-"$PKGVER"
md build-"$KABOOM_TARGET_ARCH"

# Buildroot: override some configure checks.
# These can't be assumed.
configure_native2 \
	--with-build-python="$KABOOM_TOOLCHAIN_PREFIX"/bin/python3 \
	--disable-pydoc \
	--with-ensurepip \
	ac_cv_have_long_long_format=yes \
	ac_cv_working_tzset=yes \
	ac_cv_buggy_getaddrinfo=no \
	ac_cv_file__dev_ptmx=yes \
	ac_cv_file__dev_ptc=no

make_build
make_install_native

# Somehow they are installed to the host toolchain.
abinfo "Installing site-packages ..."
rm -r "$KABOOM_TOOLCHAIN_SYSROOT"/usr/lib/python3.10/site-packages
cp -r "$KABOOM_TOOLCHAIN_PREFIX"/lib/python3.10/site-packages \
       	"$KABOOM_TOOLCHAIN_SYSROOT"/usr/lib/python3.10/
