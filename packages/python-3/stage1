#!/bin/bash
set_trap

pushd Python-"$PKGVER"

apply_patches
md build-"$KABOOM_TARGET_ARCH"

# FIXME: error: unable to find a register to spill in class 'R0_REGS'
if ab_match_arch sh3; then
	# Note: Just a quick-n-dirty way to get rid of -O2.
	export CPPFLAGS=""
	export CFLAGS="${CFLAGS/-O2/-O0}"
fi

# Buildroot: override some configure checks.
# These can't be assumed.
configure_native2 \
	--enable-shared \
	--with-build-python="$KABOOM_TOOLCHAIN_PREFIX"/bin/python3 \
	--disable-pydoc \
	--with-ensurepip \
	--with-openssl="$KABOOM_STAGE1_SYSROOT"/usr \
	ac_cv_have_long_long_format=yes \
	ac_cv_working_tzset=yes \
	ac_cv_buggy_getaddrinfo=no \
	ac_cv_file__dev_ptmx=yes \
	ac_cv_file__dev_ptc=no

make_build
make_install_native
