#!/bin/bash
set_trap
pushd Python-$PKGVER
md build-"$KABOOM_HOST_TRIPLE"

configure_tools2 \
	--with-ensurepip
make_build
make_install_tools

# FIXME: pyparsing is not yet compatible with flit-core>=4.
abinfo "Installing host modules ..."
python3 -m pip install \
	'flit-core<4' \
	setuptools \
	platformdirs \
	pep517 \
	wheel \
	pip \
	packaging \
	click \
	build \
	installer \
	pybind11 || \
	abdie "Failed to install host modules."
popd
