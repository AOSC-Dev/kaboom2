#!/bin/bash
set_trap
pushd Python-$PKGVER
md build-"$KABOOM_HOST_TRIPLE"

configure_tools2 \
	--with-ensurepip
make_build
make_install_tools

abinfo "Installing host modules ..."
python3 -m pip install --upgrade \
	flit-core \
	setuptools \
	platformdirs \
	pep517 \
	wheel \
	pip \
	packaging \
	click \
	build \
	installer \
	pybind11
popd
