#!/bin/bash
set_trap

pushd "$PKGNAME"-"$PKGVER"
md build-"$KABOOM_TARGET_ARCH"

# Well, the build system can't find just-compiled libiberty on arm*
# targets. I'm not sure why, for now just manually specify system library
# paths when cross-compiling target binutils.
LIBGCC_DIR="$("${KABOOM_TARGET_CC}" -print-file-name=libgcc_s.so.1)"
LIBGCC_DIR="$(dirname "$LIBGCC_DIR")"
export LDFLAGS="${KABOOM_TARGET_LDFLAGS} \
	-L$PWD/libiberty/pic \
	-L$LIBGCC_DIR -L$KABOOM_TOOLCHAIN_SYSROOT/usr/lib"

configure_native \
	--without-sysroot \
	--disable-multiarch \
	--disable-multilib \
	--with-build-sysroot="$(realpath "$KABOOM_TOOLCHAIN_SYSROOT")" \
	--enable-shared \
	--with-pic \
	--enable-ld \
	--enable-lto \
	--enable-plugins \
	--disable-gdb \
	--enable-default-hash-style=gnu \
	--with-bugurl=https://github.com/AOSC-Dev/kaboom2/issues
make_build
make_install_native

abinfo "Moving ldscripts to /usr/lib ..."
mv -v "$KABOOM_TOOLCHAIN_SYSROOT"/usr/"$KABOOM_TARGET_TRIPLE"/lib/ldscripts \
	"$KABOOM_TOOLCHAIN_SYSROOT"/usr/lib/

# Well, it causes problems for later bootstrapping...
# libm.so.6 needed by /usr/lib/gcc/TRIPLE/15/libstdc++.so.6
# attempt to open no/usr/lib/libm.so.6 failed
# [more attempt to open no/ prefixed locations follows]
abinfo "Removing redundant installation at multilib locations ..."
rm -rv "$KABOOM_TOOLCHAIN_SYSROOT"/usr/"$KABOOM_TARGET_TRIPLE"
