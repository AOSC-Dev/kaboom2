#!/bin/bash
set_trap

pushd "$PKGNAME"-"$PKGVER"

METADIR=$(get_pkgmetadata_dir)

# NOTE: Forcing the build system to build with standard <stdbool.h>.
# Otherwise you will get a bunch of redifinition errors in C++, since
# ncurses will use its own CURSES_BOOL which expands to either int or
# unsigned char.
md build-"$KABOOM_TARGET_ARCH"
configure_native2 \
	--with-shared \
	--with-normal \
	--with-cxx-shared \
	--without-debug \
	--without-ada \
	--without-tests \
	--disable-stripping \
	--enable-widec \
	--enable-pc-files \
	--with-pkg-config-libdir=/usr/lib/pkgconfig \
	--enable-ext-colors \
	--enable-ext-mouse \
	--enable-ext-putwin \
	--with-versioned-syms

make_build
make_install_native

abinfo "Appending wide-character linkage to pkg-config files..."
for lib in ncurses ncurses++ form panel menu; do
    echo "INPUT(-l${lib}w)" > "$KABOOM_STAGE0_SYSROOT"/usr/lib/lib${lib}.so
    ln -svf ${lib}w.pc "$KABOOM_STAGE0_SYSROOT"/usr/lib/pkgconfig/${lib}.pc
done

abinfo "Tweaking library for wide-character linkage/reference..."
echo "INPUT(-lncursesw)" > "$KABOOM_STAGE0_SYSROOT"/usr/lib/libcursesw.so

abinfo "Creating libcurses symlink..."
ln -sv libncurses.so "$KABOOM_STAGE0_SYSROOT"/usr/lib/libcurses.so

abinfo "Creating version 5 symlinks..."
for i in form panelw ncursesw ncurses++w menuw; do
    ln -svf lib${i}.so.${PKGVER} \
        "$KABOOM_STAGE0_SYSROOT"/usr/lib/lib${i}.so.5
done
ln -svf libmenuw.so.${PKGVER} \
    "$KABOOM_STAGE0_SYSROOT"/usr/lib/libmenu.so.5
ln -svf libformw.so.${PKGVER} \
    "$KABOOM_STAGE0_SYSROOT"/usr/lib/libformw.so.5
ln -svf libncursesw.so.${PKGVER} \
    "$KABOOM_STAGE0_SYSROOT"/usr/lib/libncurses.so.5

for i in tinfo tic; do
    abinfo "Creating compatibility symlinks for lib${i} ..."
    ln -svf libncursesw.so.${PKGVER} \
        "$KABOOM_STAGE0_SYSROOT"/usr/lib/lib${i}.so.${PKGVER%%.*}
    ln -svf libncursesw.so.${PKGVER} \
        "$KABOOM_STAGE0_SYSROOT"/usr/lib/lib${i}.so.5
    ln -svf lib${i}.so.${PKGVER%%.*} \
        "$KABOOM_STAGE0_SYSROOT"/usr/lib/lib${i}.so
done

abinfo "Creating symlinks for pkg-configs"
for i in tinfo tic; do
    abinfo "Creating pkg-config symlinks for lib${i} ..."
    ln -svf ncursesw.pc "$KABOOM_STAGE0_SYSROOT"/usr/lib/pkgconfig/$i.pc
done

