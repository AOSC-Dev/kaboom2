#!/bin/bash
set_trap
# Re-compile a version of GCC that is (mostly) full-featured.
pushd "$PKGNAME-$PKGVER"

if ab_match_arch ia64 ; then
	abinfo "Applying patches ..."
	METADIR="$(get_pkgmetadata_dir)"
	for patch in "$METADIR"/*.patch.ia64 ; do
		patch -Np1 < "$patch"
	done
fi

METADIR="$(get_pkgmetadata_dir)"
source "$METADIR"/spec
for p in gmp mpc mpfr ; do
	v=${p^^}VER
	v2=${!v}
	abinfo "Moving $p-$v2 into $p ..."
	mv -v "$CUR_WORKSPACE"/"$p"-"$v2" "$p"
done

md build-"$KABOOM_TARGET_ARCH"
expand_arch_def
configure_native \
	--libdir=/usr/lib \
	--libexecdir=/usr/lib \
	--enable-default-pie \
	--enable-nls \
	--enable-shared \
	--enable-lto \
	--enable-plugin \
	--disable-multilib \
	--disable-threads \
	--enable-languages="c,c++,lto" \
	--with-bugurl=https://github.com/AOSC-Dev/kaboom2/issues \
	--enable-gnu-unique-object \
	--enable-linker-build-id \
	CFLAGS_FOR_TARGET="$KABOOM_TARGET_CFLAGS -O2" \
	CXXFLAGS_FOR_TARGET="$KABOOM_TARGET_CXXFLAGS -O2"

# During stage0, build flags are set for the target. However some host
# libraries and binaries must be built, and it takes CFLAGS in the
# environment, too, resulting an error.
# Build all targets for the build environment first, without target
# specific flags set.
make_build all-build CFLAGS="-O2" CXXFLAGS="-O2"

# Then build everything else.
# FIXME: GCC still references gcc_cv_objdump when cross compiling,
# which is non-existent. The value it probably looking for is
# ac_cv_prog_objdump.
# This fails libcc1 check if LTO and plugins are enabled, since it
# tries to run target objdunmp with -T option, which then evaluates to
# " -T".
make_build \
	gcc_cv_objdump="$KABOOM_TARGET_OBJDUMP"
make_install_native

abinfo "Creating cc -> gcc ..."
ln -svf gcc "$KABOOM_STAGE0_SYSROOT"/usr/bin/cc
ln -svf g++ "$KABOOM_STAGE0_SYSROOT"/usr/bin/c++

if [ -e "$KABOOM_STAGE0_SYSROOT"/usr/lib/gcc/"$KABOOM_TARGET_TRIPLE"/"$PKGVER"/liblto_plugin.so ] ; then
	mkdir -pv "$KABOOM_STAGE0_SYSROOT"/usr/lib/bfd-plugins
	abinfo "Symlinking LTO plugin to the bfd-plugin directory ..."
	ln -svf ../gcc/"$KABOOM_TARGET_TRIPLE"/"$PKGVER"/liblto_plugin.so \
		"$KABOOM_STAGE0_SYSROOT"/usr/lib/bfd-plugins/liblto_plugin.so
fi
