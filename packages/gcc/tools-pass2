#!/bin/bash
set_trap

# Re-compile a version of GCC that is (mostly) full-featured.
pushd "$PKGNAME-$PKGVER"

apply_patches

md build-"$KABOOM_TARGET_ARCH"
expand_arch_def
configure_tools \
	--enable-default-pie \
	--disable-nls \
	--enable-lto \
	--enable-plugin \
	--enable-shared \
	--disable-multiarch \
	--disable-multilib \
	--enable-threads \
	--with-bugurl=https://github.com/AOSC-Dev/kaboom2/issues \
	--enable-gnu-unique-object \
	--enable-linker-build-id \
	--enable-languages="c,c++,d,ada" \
	LDFLAGS="-lm" LIBS="-lm"
make_build
make_install_tools
