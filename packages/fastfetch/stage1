#!/bin/bash
set_trap

pushd fastfetch.git

# grep -Po '(?<=_option\()[A-Z_]*' CMakeLists.txt
cmake_native \
	"$PWD" \
	"$PWD"/build-"$KABOOM_TARGET_ARCH" \
	-DENABLE_VULKAN=OFF \
	-DENABLE_WAYLAND=OFF \
	-DENABLE_XCB_RANDR=OFF \
	-DENABLE_XRANDR=OFF \
	-DENABLE_DRM=OFF \
	-DENABLE_DRM_AMDGPU=OFF \
	-DENABLE_GIO=OFF \
	-DENABLE_DCONF=OFF \
	-DENABLE_DBUS=OFF \
	-DENABLE_SQLITE3=OFF \
	-DENABLE_RPM=OFF \
	-DENABLE_IMAGEMAGICK=OFF \
	-DENABLE_IMAGEMAGICK=OFF \
	-DENABLE_CHAFA=OFF \
	-DENABLE_EGL=OFF \
	-DENABLE_GLX=OFF \
	-DENABLE_OPENCL=OFF \
	-DENABLE_FREETYPE=OFF \
	-DENABLE_PULSE=OFF \
	-DENABLE_DDCUTIL=OFF \
	-DENABLE_DIRECTX_HEADERS=OFF \
	-DENABLE_THREADS=OFF \
	-DENABLE_LIBZFS=OFF

cmake_build "$PWD"/build-"$KABOOM_TARGET_ARCH"
cmake_install_native "$PWD"/build-"$KABOOM_TARGET_ARCH"
