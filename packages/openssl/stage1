#!/bin/bash
set_trap

pushd "$PKGNAME"-"$PKGVER"

env \
CC="$KABOOM_TARGET_CC" \
CXX="$KABOOM_TARGET_CXX" \
LD="$KABOOM_TARGET_LD" \
	./Configure \
	$KABOOM_TARGET_OPENSSL_TARGET \
	--prefix=/usr \
	--openssldir=/etc/ssl \
	shared \
	no-docs \
	no-fuzz-libfuzzer \
	no-fuzz-afl \
	no-afalgeng \
	enable-camellia \
	no-unit-test

make_build
make_install_native
