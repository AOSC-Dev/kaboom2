#!/bin/bash
set_trap

abinfo "Making stubs ..."
for bin in \
	apt apt-cache apt-get \
	go gem meson ninja python2 ruby \
	tclsh; do
	ln -svf "true" \
		"$KABOOM_STAGE1_SYSROOT"/usr/bin/"$bin"
done
abinfo "Making systemd stubs ..."
for bin in \
	systemctl \
	systemd-detect-virt \
	systemd-sysusers \
	systemd-tmpfiles \
	systemd-hwdb ; do
	ln -svf true "$KABOOM_STAGE1_SYSROOT"/usr/bin/"$bin"
done

ln -sfv false "$KABOOM_STAGE1_SYSROOT"/usr/bin/oma

abinfo "Creating /etc/passwd ..."
echo "root:x:0:0:root:/root:/bin/bash" > \
	"$KABOOM_STAGE1_SYSROOT"/etc/passwd
abinfo "Creating /etc/group ..."
echo "root:x:0:" > \
	"$KABOOM_STAGE1_SYSROOT"/etc/group
