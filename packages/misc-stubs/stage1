#!/bin/bash
set_trap

METADIR="$(get_pkgmetadata_dir)"

abinfo "Making stubs ..."
for bin in \
	apt apt-cache apt-get \
	go gem python2 \
	tclsh; do
	ln -svf "true" \
		"$KABOOM_STAGE1_SYSROOT"/usr/bin/"$bin"
done
abinfo "Making systemd stubs ..."
for bin in \
	systemctl \
	systemd-detect-virt \
	systemd-sysusers \
	systemd-tmpfiles \
	systemd-hwdb ; do
	ln -svf true "$KABOOM_STAGE1_SYSROOT"/usr/bin/"$bin"
done

abinfo "Creating necessary stubs for aosc-aaa ..."
for bin in \
	useradd \
	usermod \
	groupadd ; do
	ln -svf true "$KABOOM_STAGE1_SYSROOT"/usr/bin/"$bin"
done

abinfo "Creating /etc/passwd ..."
cp -v "$METADIR"/passwd \
	"$KABOOM_STAGE1_SYSROOT"/etc/passwd
abinfo "Creating /etc/group ..."
cp -v "$METADIR"/group \
	"$KABOOM_STAGE1_SYSROOT"/etc/group
