#!/bin/bash
set_trap
pushd "$PKGNAME"-"$PKGVER"
md build-"$KABOOM_TARGET_ARCH"

configure_native2 \
	--enable-multibyte \
	--enable-shared \
	--disable-install-examples \
	--with-curses \
	--with-shared-termcap-library=-lncursesw

make_build
make_install_native

abinfo "Installing inputrc ..."
METADIR="$(get_pkgmetadata_dir)"
install -Dvm644 "$METADIR"/inputrc \
	"$KABOOM_TOOLCHAIN_SYSROOT"/etc/inputrc
