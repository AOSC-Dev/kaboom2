#!/bin/bash
set_trap

pushd "$PKGNAME"-"$PKGVER"
md build-"$KABOOM_TARGET_ARCH"

PKG_CONFIG_PATH="$KABOOM_TARGET_PKGCONFIG" \
	configure_native2 \
	--with-openssl \
	--enable-threads \
	--disable-threaded-resolver \
	--without-libpsl \
	--with-ca-bundle=/etc/ssl/ca-bundle.crt

make_build
make_install_native
